<?xml version="1.0" encoding="utf-8"?>
<!-- Blocca traffico in chiaro: tutte le chiamate (Graph, SharePoint, SMTP) devono essere TLS -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
